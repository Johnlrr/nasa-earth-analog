{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Johnlrr/nasa-earth-analog/schemas/candidate.schema.json",
  "title": "SIMILITUDE candidates FeatureCollection",
  "description": "Contract for web/data/candidates.geojson (DESIGN 2.4 + PLAN schema section). Locked 13:45 14/11/2026.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "metadata": {"type": "object"},
    "features": {"type": "array", "items": {"$ref": "#/$defs/any_feature"}}
  },
  "$defs": {
    "lens_id": {"enum": ["L1", "L2", "M1", "X1"]},
    "number_or_null": {"type": ["number", "null"]},
    "lens_list": {"type": "array", "items": {"$ref": "#/$defs/lens_id"}, "uniqueItems": true},
    "any_feature": {
      "description": "B17: a cell-level candidate (default) or a site (properties.feature_type == 'site', 2c contract config/sites.yaml)",
      "if": {"properties": {"properties": {"properties": {"feature_type": {"const": "site"}},
                                           "required": ["feature_type"]}}},
      "then": {"$ref": "#/$defs/site_feature"},
      "else": {"$ref": "#/$defs/feature"}
    },
    "site_feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "geometry": {"$ref": "#/$defs/feature/properties/geometry"},
        "properties": {"$ref": "#/$defs/site"}
      }
    },
    "card_row": {
      "type": "object",
      "required": ["lens", "variable"],
      "properties": {
        "lens": {"$ref": "#/$defs/lens_id"},
        "target": {"type": ["string", "null"]},
        "target_label": {"type": ["string", "null"]},
        "variable": {"type": "string"},
        "value": {"type": ["number", "string", "null"]},
        "reason": {"type": ["string", "null"]},
        "facility": {"type": ["string", "null"]},
        "source": {"type": ["string", "null"]},
        "n_cells": {"type": ["integer", "null"]},
        "best_cell": {"type": ["string", "null"]}
      }
    },
    "site": {
      "description": "Column names exactly as data/derived/sites.parquet (A17); field/facility/unobserved from data/derived/field_facility.json (A20)",
      "type": "object",
      "required": ["feature_type", "id", "site_id", "name", "lat", "lon", "n_cells", "member_cells",
                   "max_span_km", "lenses_engine_confirmed", "lenses_engine_semiquant",
                   "lenses_hypothesis", "lenses_literature_only", "b10_unreviewed_cells",
                   "hidden_status", "field", "facility", "unobserved"],
      "properties": {
        "feature_type": {"const": "site"},
        "id": {"type": "string", "minLength": 1},
        "site_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "n_cells": {"type": "integer", "minimum": 1},
        "member_cells": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "max_span_km": {"type": "number", "minimum": 0},
        "lenses": {"$ref": "#/$defs/lens_list"},
        "targets": {"type": "array", "items": {"type": "string"}},
        "lenses_engine_confirmed": {"$ref": "#/$defs/lens_list"},
        "lenses_engine_semiquant": {"$ref": "#/$defs/lens_list"},
        "lenses_hypothesis": {"$ref": "#/$defs/lens_list"},
        "lenses_literature_only": {"$ref": "#/$defs/lens_list"},
        "b10_unreviewed_cells": {"type": "array", "items": {"type": "string"}},
        "hidden_status": {"type": "string", "minLength": 1},
        "attention_n": {"type": ["integer", "null"], "minimum": 0},
        "n_in_exclusion": {"type": "integer", "minimum": 0},
        "n_ice_flag": {"type": "integer", "minimum": 0},
        "showcase": {"type": "string"},
        "note": {"type": ["string", "null"]},
        "l2_snow_free_frac": {"type": "object"},
        "field": {"type": "array", "items": {"$ref": "#/$defs/card_row"}},
        "facility": {"type": "array",
                     "items": {"allOf": [{"$ref": "#/$defs/card_row"},
                                         {"required": ["facility", "source"]}]}},
        "unobserved": {"type": "array", "items": {"$ref": "#/$defs/card_row"}},
        "multilens": {"type": "array", "items": {"type": "object"}},
        "data_sources": {"type": "array", "items": {"type": "string"}}
      }
    },
    "feature": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "Point"},
            "coordinates": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": -180, "maximum": 180},
                {"type": "number", "minimum": -90, "maximum": 90}
              ],
              "minItems": 2,
              "maxItems": 3
            }
          }
        },
        "properties": {"$ref": "#/$defs/candidate"}
      }
    },
    "lens_score": {
      "type": "object",
      "required": ["target", "d", "sigma", "sigma_capped", "percentile", "limiting_factor", "no_analog"],
      "properties": {
        "target": {"type": "string"},
        "d": {"type": "number", "minimum": 0},
        "sigma": {"type": "number", "minimum": 0},
        "sigma_capped": {"type": "boolean"},
        "percentile": {"$ref": "#/$defs/number_or_null"},
        "limiting_factor": {"type": "string"},
        "no_analog": {"type": "boolean"},
        "metric_mode": {"enum": ["full", "pca", "diag"]},
        "n_null": {"type": ["integer", "null"]},
        "native_rank": {"type": ["integer", "null"], "minimum": 0},
        "n_native": {"type": ["integer", "null"], "minimum": 0},
        "native_rank_basis": {"type": ["string", "null"]},
        "matched_area_km2": {"$ref": "#/$defs/number_or_null"},
        "largest_patch_km2": {"$ref": "#/$defs/number_or_null"},
        "d_shadow": {"$ref": "#/$defs/number_or_null"},
        "sigma_shadow": {"$ref": "#/$defs/number_or_null"},
        "descriptors": {
          "type": "object",
          "description": "descriptor name -> {earth, target, z} (z = signed deviation / scale)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "earth": {"$ref": "#/$defs/number_or_null"},
              "target": {"$ref": "#/$defs/number_or_null"},
              "z": {"$ref": "#/$defs/number_or_null"}
            }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["id", "name", "lat", "lon", "footprint_km", "process_title", "lens_scores",
                   "test_here", "cannot_test", "attention", "evidence_status", "data_sources"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "country": {"type": "string"},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "footprint_km": {"type": "number", "exclusiveMinimum": 0},
        "role": {"enum": ["hidden", "control", "decoy", "seed"]},
        "analog_role": {"enum": ["aqueous", "substrate-baseline", "terrain", "ice-configuration"]},
        "verdicts": {
          "type": "array",
          "description": "B16: rows read from data/derived/verdicts.parquet (A15), never generated here",
          "items": {
            "type": "object",
            "required": ["test", "variable", "state"],
            "properties": {
              "lens": {"$ref": "#/$defs/lens_id"},
              "scope": {"enum": ["cell", "lens"]},
              "test": {"type": "string"},
              "variable": {"type": "string"},
              "state": {"enum": ["TRANSFERS", "NO-ANALOG", "UNOBSERVED"]},
              "value": {"type": ["number", "string", "null"]},
              "reason": {"type": ["string", "null"]},
              "facility": {"type": ["string", "null"]}
            }
          }
        },
        "process_title": {"type": "string", "minLength": 1},
        "process_summary": {"type": "string"},
        "lens_scores": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/lens_id"},
          "additionalProperties": {"$ref": "#/$defs/lens_score"}
        },
        "process_rates": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/number_or_null"}
        },
        "test_here": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tech"],
            "properties": {
              "tech": {"type": "string"},
              "nasa_gap": {"type": ["string", "null"]},
              "lens": {"$ref": "#/$defs/lens_id"}
            }
          }
        },
        "cannot_test": {"type": "array", "items": {"type": "string"}},
        "attention": {
          "type": "object",
          "required": ["n_pubs", "query", "source", "date"],
          "properties": {
            "n_pubs": {"type": ["integer", "null"], "minimum": 0},
            "query": {"type": "string"},
            "source": {"type": "string"},
            "date": {"type": "string"}
          }
        },
        "access": {
          "type": "object",
          "properties": {
            "travel_time_h": {"$ref": "#/$defs/number_or_null"},
            "protected_area": {"type": ["boolean", "null"]},
            "note": {"type": "string"}
          }
        },
        "in_exclusion_buffer": {"type": "boolean"},
        "evidence_status": {"enum": ["engine-confirmed", "engine-semiquant", "literature-only", "hypothesis"]},
        "evidence_note": {"type": "string"},
        "data_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "mock": {"type": "boolean"}
      }
    }
  }
}
